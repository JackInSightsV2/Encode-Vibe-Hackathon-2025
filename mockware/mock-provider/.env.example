# QT-1 Mock AI Provider Configuration

# Server Configuration
PORT=8081
NODE_ENV=development

# Response Timing Configuration
RESPONSE_DELAY_MIN=100
RESPONSE_DELAY_MAX=500

# Error Simulation
ERROR_RATE=0.05

# Rate Limiting Simulation
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW=60000

# Token Pricing (per token)
TOKEN_RATE_INPUT=0.0001
TOKEN_RATE_OUTPUT=0.0002

# Features
ENABLE_STREAMING=true
ENABLE_DETAILED_LOGGING=true

# Template and Personality Loading
TEMPLATES_DIR=./responses/templates
PERSONALITIES_DIR=./responses/personalities

# Network Simulation
SIMULATE_NETWORK_ISSUES=false
NETWORK_ERROR_RATE=0.01

# Content Moderation Sensitivity
MODERATION_STRICTNESS=medium

# API Compatibility
OPENAI_COMPATIBLE=true
ANTHROPIC_COMPATIBLE=true
GENERIC_API_ENABLED=true