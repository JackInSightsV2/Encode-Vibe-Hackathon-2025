{
  "name": "qt1-mock-provider",
  "version": "1.0.0",
  "description": "Mock AI provider backend for QT-1 middleware testing",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "self-test": "node self-test.js",
    "test": "node run-self-test.js",
    "test:manual": "npm run self-test",
    "test:endpoints": "./test-endpoints.sh",
    "health": "curl -s http://localhost:8081/health | jq '.'",
    "docker:build": "docker build -t qt1-mock-provider .",
    "docker:run": "docker run -p 8081:8081 --env-file .env qt1-mock-provider"
  },
  "keywords": [
    "mock",
    "ai-provider",
    "openai",
    "anthropic",
    "testing",
    "simulation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}